# ==============================================
# DevTrace AI - Environment Configuration Example
# Copy this file to .env in backend/ or root
# ==============================================

# Backend Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/devtrace?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/devtrace

# Gemini API Key for Failure Diagnosis
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (for frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

